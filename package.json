{
  "name": "jrjs-template",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "jrjs-template framework",
  "author": "JR <javier.rey.eu@gmail.com> (https://javierrey.github.io)",
  "workspaces": [
    "packages/*"
  ],
  "main": "",
  "scripts": {
    "status": "echo CLEAN: && git clean -nfdX -e !.* -e !**/_ignore/ -e !**/_ignore/** && echo NEW: && git ls-files -o --exclude-standard",
    "clean": "git clean -fdX -e !.* -e !**/_ignore/ -e !**/_ignore/**",
    "reinstall": "npm run clean && npm i && npm i github:javierrey/jrjs --save-dev",
    "format:sys": "npx eslint ./packages/sys",
    "format:view": "npx eslint ./packages/view",
    "format": "npm run format:sys && npm run format:view",
    "prebuild": "node ./node_modules/jrjs/packages/utils/sys/build/prebuild.js symlink --orig=\"\" --dest=\"\" --imports-core=\"\" --imports-view=\"\"",
    "build:sys": "node ./node_modules/jrjs/packages/utils/sys/build/build.js sys minify \"{}\"",
    "build:view": "node ./node_modules/jrjs/packages/utils/sys/build/build.js view minify \"{}\"",
    "build": "npm run prebuild && npm run build:sys && npm run build:view",
    "rebuild": "npm run reinstall && npm run build",
    "start": "node --preserve-symlinks --preserve-symlinks-main ./dist/sys/index.js \"{}\"",
    "start:dev": "node --preserve-symlinks --preserve-symlinks-main ./packages/sys/index.js \"{}\"",
    "stop": "echo @todo stop",
    "restart": "npm run stop && npm run build && npm run start",
    "restart:dev": "npm run stop && npm run prebuild && npm run start:dev",
    "test:sys": "npm -w packages/sys run test",
    "test:view": "npm -w packages/view run test",
    "test": "npm run test:sys && npm run test:view"
  },
  "_ignore": {
    "jrjs": "github:javierrey/jrjs",
    "jrjs-github": "github:javierrey/jrjs",
    "jrjs-local": "file:../jrjs",
    "jrjs-http": "https://github.com/javierrey/jrjs"
  },
  "devDependencies": {
    "jrjs": "github:javierrey/jrjs"
  }
}
