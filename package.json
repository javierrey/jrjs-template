{
  "name": "jrjs-template",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "jrjs-template framework",
  "author": "JR <javier.rey.eu@gmail.com> (https://javierrey.github.io)",
  "workspaces": [
    "packages/*"
  ],
  "main": "",
  "scripts": {
    "status": "echo CLEAN: && git clean -nfdX -e !.* -e !**/_ignore/ -e !**/_ignore/** && echo NEW: && git ls-files -o --exclude-standard",
    "clean": "git clean -fdX -e !.* -e !**/_ignore/ -e !**/_ignore/**",
    "reinstall": "npm run clean && npm i && npm i github:javierrey/jrjs",
    "format:main:sys": "npx eslint packages/main/sys",
    "format:main:view": "npx eslint packages/main/view",
    "format:main": "npm run format:main:sys && npm run format:main:view",
    "prebuild:main": "node node_modules/jrjs/packages/utils/sys/build/prebuild.js --method=symlink --orig=node_modules/jrjs/packages --dest=packages/main --view-imports=1 --sys-imports=",
    "build:main": "npm run prebuild:main && node node_modules/jrjs/packages/utils/sys/build/build.js --method=minify --packages=main/sys,main/view config=\"{}\"",
    "test:main:sys": "npm -w packages/main/sys run test",
    "test:main:view": "npm -w packages/main/view run test",
    "test:main": "npm run test:main:sys && npm run test:main:view",
    "start:main": "node --preserve-symlinks --preserve-symlinks-main dist/main/sys/index.js \"{}\"",
    "start:dev:main": "npm run prebuild:main && node --preserve-symlinks --preserve-symlinks-main packages/main/sys/index.js \"{}\"",
    "format": "npm run format:main",
    "prebuild": "npm run prebuild:main",
    "build": "npm run build:main",
    "rebuild": "npm run reinstall && npm run build",
    "test": "npm run test:main",
    "start": "npm run start:main",
    "start:dev": "npm run start:dev:main",
    "stop": "echo @todo stop",
    "restart": "npm run stop && npm run build && npm run start",
    "restart:dev": "npm run stop && npm run prebuild && npm run start:dev"
  },
  "_ignore": {
    "jrjs": "github:javierrey/jrjs",
    "jrjs-github": "github:javierrey/jrjs",
    "jrjs-local": "file:../jrjs",
    "jrjs-http": "https://github.com/javierrey/jrjs"
  },
  "dependencies": {
    "jrjs": "github:javierrey/jrjs"
  }
}
