{
  "name": "jrjs-template",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "description": "jrjs-template framework",
  "author": "JR <javier.rey.eu@gmail.com> (https://javierrey.github.io)",
  "workspaces": [
    "packages/*"
  ],
  "main": "",
  "scripts": {
    "node:args": "node --preserve-symlinks --preserve-symlinks-main",
    "git:clean": "git -c core.longPaths=true clean",
    "status": "echo CLEAN: && pnpm git:clean -nfdX -e !.* -e !**/_ignore/ -e !**/_ignore/** && echo NEW: && git ls-files -o --exclude-standard",
    "clean": "pnpm git:clean -fdX -e !.* -e !**/_ignore/ -e !**/_ignore/**",
    "clean:install": "pnpm clean && pnpm i && pnpm add github:javierrey/jrjs --force -w",
    "format:main": "npx eslint packages/main",
    "sync-source:main": "node node_modules/jrjs/packages/utils/drive/builder/sync-source.js --method=symlink --orig=node_modules/jrjs/packages --dest=packages/main --view-imports=1 --drive-imports=",
    "build:main": "pnpm sync-source:main && node node_modules/jrjs/packages/utils/drive/builder/build.js --method=minify --packages=main config=\"{}\"",
    "test:main:drive": "npm -w packages/main/drive run test",
    "test:main:view": "npm -w packages/main/view run test",
    "test:main": "pnpm test:main:drive && pnpm test:main:view",
    "start:dev:main": "pnpm sync-source:main && pnpm node:args packages/main/drive/index.js \"{}\"",
    "start:main": "pnpm node:args dist/main/drive/index.js \"{}\"",
    "clean:start:main": "pnpm build:main && pnpm node:args dist/main/drive/index.js \"{}\"",
    "format": "pnpm format:main",
    "sync-source": "pnpm sync-source:main",
    "build": "pnpm build:main",
    "clean:build": "pnpm clean:install && pnpm build",
    "test": "pnpm test:main",
    "stop:dev": "node packages/main/drive/stop.js",
    "stop": "node dist/main/drive/stop.js",
    "start:dev": "pnpm stop:dev && pnpm start:dev:main",
    "start": "pnpm stop && pnpm start:main",
    "clean:start": "pnpm stop && pnpm clean:start:main"
  },
  "dependencies": {
    "jrjs": "github:javierrey/jrjs"
  },
  "_ignore": {
    "jrjs@github": "github:javierrey/jrjs",
    "jrjs@http": "https://github.com/javierrey/jrjs",
    "jrjs@local": "file:../jrjs"
  }
}
